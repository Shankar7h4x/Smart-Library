# Multi-Provider AI Configuration Example
# Copy this file to .env and insert your real API keys.

# Primary Provider (openai | groq | gemini)
AI_PROVIDER=openai

# 1. OpenAI GPT API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_KEYS=

# 2. Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_KEYS=

# 3. Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_KEYS=

